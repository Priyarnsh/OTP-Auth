# ─── Server ────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Frontend URL (for CORS) ──────────────────────────
CLIENT_URL=http://localhost:3000

# ─── Database (MongoDB) ───────────────────────────────
# Local MongoDB
DATABASE_URL="mongodb://localhost:27017/otp_auth"
# MongoDB Atlas (production — uncomment and fill in)
# DATABASE_URL="mongodb+srv://user:password@cluster.xxxxx.mongodb.net/otp_auth?retryWrites=true&w=majority"

# ─── Redis ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# For Upstash (cloud Redis):
# REDIS_URL=rediss://default:YOUR_TOKEN@YOUR_ENDPOINT.upstash.io:6379

# ─── JWT Secrets ───────────────────────────────────────
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-access
JWT_REFRESH_SECRET=change-me-to-a-long-random-string-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Resend (Email) ───────────────────────────────────
# Leave blank to use console fallback in development
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ─── Twilio (SMS) ─────────────────────────────────────
# Leave blank to use console fallback in development
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── OTP Settings ─────────────────────────────────────
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
